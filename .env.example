# Hugging Face cache location and token (a token raises Hub rate limits; no gated models are used).
HF_HOME=~/.cache/huggingface
# HF_TOKEN=hf_...

# Force offline mode once checkpoints and datasets are cached (pinned revisions resolve from the cache).
# HF_HUB_OFFLINE=1

# Override the device in every model config: auto | cpu | mps | cuda | cuda:1
# CODEINTEL_DEVICE=mps

# Run tests that download the real checkpoints.
# CODEINTEL_NETWORK_TESTS=1
